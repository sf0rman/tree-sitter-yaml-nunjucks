# Example YAML + Nunjucks + CloudFormation + OrgFormation
# Demonstrates syntax highlighting for mixed templates

# Top-level Nunjucks conditional
{% if deploy_to_production %}
environment: production
replicas: 10
enable_monitoring: true
{% else %}
environment: development
replicas: 1
enable_monitoring: false
{% endif %}

# Basic Nunjucks templating
database:
  host: "{{ db_host }}"
  port: {{ db_port | default(5432) }}
  name: "my_app_{{ environment }}"

# Nunjucks loops
features:
  {% for feature in enabled_features %}
  - name: {{ feature.name }}
    enabled: {{ feature.enabled }}
  {% endfor %}

{# This is a Nunjucks comment #}

# CloudFormation + OrgFormation + Nunjucks mixed example
AWSTemplateFormatVersion: "2010-09-09"
Description: "{{ stack_description }}"

Resources:
  # AWS S3 Bucket with CloudFormation intrinsics and Nunjucks
  StorageBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub "{{ bucket_prefix }}-${AWS::AccountId}"
      Tags:
        - Key: Environment
          Value: {{ environment }}
        - Key: Region
          Value: {{ primary_region }}

  # Conditional Lambda with Nunjucks
  {% if enable_lambda %}
  ProcessorFunction:
    Type: AWS::Lambda::Function
    Properties:
      FunctionName: !Sub "${EnvironmentName}-processor"
      Runtime: python3.11
      Handler: index.handler
      Role: !GetAtt LambdaExecutionRole.Arn
      Environment:
        Variables:
          BUCKET_NAME: !Ref StorageBucket
          DEBUG_MODE: "{{ debug_mode | default('false') }}"
  {% endif %}

  # AWS IAM Role
  LambdaExecutionRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              Service: lambda.amazonaws.com
            Action: sts:AssumeRole

Outputs:
  BucketArn:
    Value: !GetAtt StorageBucket.Arn
    Export:
      Name: !Sub "{{ stack_prefix }}-bucket-arn"

Something:
    Tags:
       - Hello
{% for arn in policyArns %}
       - !Sub {{ arn }}
{% endfor %}
    VpcConfig:
      SecurityGroupIds:
        - !Ref SecurityGroup
      SubnetIds: !Ref subnetIds
      Environment:
        Variables:
          {% for name, value in environment %}
            {% if value !== "" %}
              "{{ name }}": !Sub "{{ value }}"
            {% else %}
              "{{ name }}": ""
            {% endif %}
          {% endfor %}

ExampleWithNunjucksProperty:
  Type: Something
  {{PropertyNameIsNunjucks}}: {{is this}}
  '{{TopicName}}Topic': hello


{% if createExampleQueue %}
  ExampleQueue:
      Type: AWS::SQS::Queue
      DeletionPolicy: RetainExceptOnCreate
      UpdateReplacePolicy: Retain
      Properties:
        QueueName: !Sub "${AWS::StackName}-example-queue"
        KmsMasterKeyId: !Ref KmsKey
        MessageRetentionPeriod: !Ref exampleQueueMessageRetentionSeconds
        VisibilityTimeout: !Ref exampleQueueVisibilityTimeoutSeconds
        RedrivePolicy:
          deadLetterTargetArn: !GetAtt ExampleDlQueue.Arn
          maxReceiveCount: !Ref exampleQueueMaxReceiveCount

  ExampleDlQueue:
      Type: AWS::SQS::Queue
      DeletionPolicy: RetainExceptOnCreate
      UpdateReplacePolicy: Retain
      Properties:
        QueueName: !Sub "${AWS::StackName}-example-queue-dlq"
        KmsMasterKeyId: !Ref KmsKey
        MessageRetentionPeriod: !Ref exampleQueueMessageRetentionSeconds

  ExampleQueuePolicy:
      Type: AWS::SQS::QueuePolicy
      Properties:
        PolicyDocument:
          Version: 2012-10-17
          Statement:
            - Effect: Allow
              Principal:
                Service: s3.amazonaws.com
              Action: sqs:SendMessage
              Resource:
                - !GetAtt ExampleQueue.Arn
              Condition:
                ArnLike:
                  'aws:SourceArn': !Sub "arn:aws:s3:::${AWS::StackName}"
                StringEquals:
                  'aws:SourceAccount': !Ref AWS::AccountId
        Queues:
          - !Ref ExampleQueue
{% endif %}

{% if createTopics %}
  {% for topic in createTopics %}
  {{topic.nameRef}}:
    Type: AWS::SNS::Topic
    DeletionPolicy: RetainExceptOnCreate
    Properties:
      TopicName: !Sub  "${AWS::StackName}-{{topic.name}}"
      DisplayName: !Sub "Notifications for new {{topic.prefix}} events in ${AWS::StackName}"
      KmsMasterKeyId: !Ref KmsKey

  '{{topic.nameRef}}Policy':
    Type: AWS::SNS::TopicPolicy
    Properties:
      PolicyDocument:
        Version: 2012-10-17
        Statement:
          - Sid: 'Allow S3 to publish messages'
            Effect: Allow
            Principal:
              Service: s3.amazonaws.com
            Action:
              - sns:Publish
            Resource: !Ref {{topic.nameRef}}
            Condition:
              ArnLike:
                'aws:SourceArn': !Sub "arn:aws:s3:::${AWS::StackName}"
              StringEquals:
                'aws:SourceAccount': !Ref AWS::AccountId
          - Sid: 'Allow SQS to subscribe to the topic'
            Effect: Allow
            Principal:
              Service: sqs.amazonaws.com
            Action:
              - sns:Subscribe
            Resource: !Ref {{topic.nameRef}}
            Condition:
              StringEquals:
                'aws:SourceAccount': !Ref AWS::AccountId
          - !If
            - HasExtraPrincipals
            - Sid: 'Allow services in other accounts to subscribe to the topic'
              Effect: Allow
              Principal:
                  AWS: !Ref extraPrincipals
              Action: sns:Subscribe
              Resource: !Ref {{topic.nameRef}}
            - !Ref AWS::NoValue
    {% for permission in readPermissions %}
          - Sid: '{{permission.sid}}'
            Effect: Allow
            Principal:
              AWS:
      {% for principal in permission.principals %}
                - !Sub '{{ principal }}'
      {% endfor %}
            Action:
              - sns:Subscribe
            Resource: !Ref {{topic.nameRef}}
    {% endfor %}
      Topics:
        - !Ref {{topic.nameRef}}
  {% endfor %}
{% endif %}
